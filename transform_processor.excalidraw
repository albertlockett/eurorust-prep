      "text": "logs |\n  // filter out all debug logs\n  where severity_text != \"DEBUG\";\n\n// process logs/metrics/traces:\nsignals |\n  // decorate some telemetry\n  if (resource.attributes[\"k8s.ns.name\"] == \"my-app\") {\n     set attributes[\"important\"] = true\n  }\n  // ...\n  ",
